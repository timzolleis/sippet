{
  "name": "sippet",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . public/*.js",
    "dev": "alchemy dev --stage dev_$(basename $(git rev-parse --show-toplevel))",
    "deploy": "alchemy deploy --stage prod",
    "invite": "node --env-file-if-exists=.env scripts/invite.ts",
    "auth:generate": "auth generate --config scripts/auth-schema.ts --output migrations/auth/0001_better_auth.sql -y",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/core": "1.7.13",
    "@better-auth/mcp": "1.7.13",
    "@better-auth/passkey": "1.7.13",
    "better-auth": "1.7.13",
    "better-call": "1.4.4",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.5",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@cloudflare/workers-types": "5.20261024.1",
    "@effect/platform-node": "4.0.5",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "26.6.5",
    "alchemy": "2.0.0-beta.84",
    "auth": "1.7.13",
    "oxlint": "1.89.0",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
