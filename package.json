    "better-call": "1.4.4",
    "effect": "4.0.5",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "26.6.5",
    "alchemy": "2.0.0-beta.84",
    "auth": "1.7.13",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
