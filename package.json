{
  "name": "sippet",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "oxlint .",
    "build": "vite build",
    "dev": "vite build && (vite build --watch --logLevel warn & alchemy dev --stage dev_$(basename $(git rev-parse --show-toplevel)))",
    "deploy": "vite build && alchemy deploy --stage prod --yes",
    "invite": "node --env-file-if-exists=.env scripts/invite.ts",
    "device-token": "node scripts/device-token.ts",
    "dev-cook": "node scripts/dev-cook.ts",
    "verify:device-sign-in": "node scripts/verify-device-sign-in.ts",
    "golden": "node scripts/golden.ts",
    "auth:generate": "auth generate --config scripts/auth-schema.ts --output migrations/auth/0001_better_auth.sql -y",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/core": "1.7.13",
    "@better-auth/mcp": "1.7.13",
    "@better-auth/passkey": "1.7.13",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-virtual": "3.14.13",
    "better-auth": "1.7.13",
    "better-call": "1.4.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "effect": "4.0.5",
    "framer-motion": "13.4.4",
    "jose": "6.2.13",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-use-measure": "2.1.7",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@cloudflare/workers-types": "5.20261024.1",
    "@effect/platform-node": "4.0.5",
    "@oxlint/plugins": "1.89.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "alchemy": "2.0.0-beta.84",
    "auth": "1.7.13",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
