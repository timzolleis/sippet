{
  "name": "sippet-spike",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "COOK_LIBRARY", "class_name": "CookLibrary" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CookLibrary"] }]
}
